if [ ! -e '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/edge_follow_public_road_forward_param.pb.txt' ]; then mkdir -p '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf' && ln -snf '/opt/apollo/neo/share/modules/control/controllers/lat_based_lqr_plus_controller/conf/edge_follow_public_road_forward_param.pb.txt' '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/edge_follow_public_road_forward_param.pb.txt'; fi

echo "[INFO] symbolic links of ${PACKAGE_NAME} created."

if [ -f "${APOLLO_PATH}update_dylib.sh" ]
then
    sh ${APOLLO_PATH}update_dylib.sh
fi