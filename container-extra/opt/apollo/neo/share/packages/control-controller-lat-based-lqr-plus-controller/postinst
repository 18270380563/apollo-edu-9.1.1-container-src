if [ ! -e '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/public_road_forward_s_turn_param.pb.txt' ]; then mkdir -p '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf' && ln -snf '/opt/apollo/neo/share/modules/control/controllers/lat_based_lqr_plus_controller/conf/public_road_forward_s_turn_param.pb.txt' '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/public_road_forward_s_turn_param.pb.txt'; fi
if [ ! -e '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/controller_conf.pb.txt' ]; then mkdir -p '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf' && ln -snf '/opt/apollo/neo/share/modules/control/controllers/lat_based_lqr_plus_controller/conf/controller_conf.pb.txt' '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/conf/controller_conf.pb.txt'; fi
