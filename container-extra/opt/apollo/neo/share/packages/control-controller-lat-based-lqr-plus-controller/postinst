if [ ! -e '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/lateral_controller_test/conf/controller_conf.pb.txt' ]; then mkdir -p '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/lateral_controller_test/conf' && ln -snf '/opt/apollo/neo/share/modules/control/controllers/lat_based_lqr_plus_controller/lateral_controller_test/conf/controller_conf.pb.txt' '/apollo/modules/control/controllers/lat_based_lqr_plus_controller/lateral_controller_test/conf/controller_conf.pb.txt'; fi
