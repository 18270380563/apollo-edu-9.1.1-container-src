# !/bin/sh
APOLLO_PATH='/opt/apollo/neo/'
PACKAGE_NAME='perception-lidar-detection-filter'
PACKAGE_NAME_WITH_VER='perception-lidar-detection-filter/9.1.1'
INCLUDE_PATH=''
echo "[INFO] start to create symbolic links of ${PACKAGE_NAME}"
echo '[WARN] the links of pre-version will be overwrited!'

mkdir -p ${APOLLO_PATH}bin
mkdir -p ${APOLLO_PATH}include
mkdir -p ${APOLLO_PATH}lib

chmod a+rw ${APOLLO_PATH}bin ${APOLLO_PATH}include ${APOLLO_PATH}lib ${APOLLO_PATH}packages

if [ ! -d ${APOLLO_PATH}/share/packages/${PACKAGE_NAME} ]
then
    ln -snf ${APOLLO_PATH}packages/${PACKAGE_NAME_WITH_VER} ${APOLLO_PATH}packages/${PACKAGE_NAME}/latest

    if [ "${INCLUDE_PATH}" = "" ]
    then
        ori_inc_path="${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/include"
        if [ -d ${ori_inc_path} ]
        then
            for file in $(ls ${ori_inc_path})
            do
                if [ -d ${ori_inc_path}"/"${file} ]
                then
                    ln -snf ${ori_inc_path}"/"${file} "${APOLLO_PATH}include/${file}"
                fi
            done
        fi
    else
        if [ $(dirname ${INCLUDE_PATH}) != '.' ]
        then
            mkdir -p "${APOLLO_PATH}include/$(dirname ${INCLUDE_PATH})"
            chmod a+rw "${APOLLO_PATH}include/$(dirname ${INCLUDE_PATH})"
        fi
        ln -snf "${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/include" "${APOLLO_PATH}include/${INCLUDE_PATH}"
    fi

    if [ -d ${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/lib ]
    then
        ln -snf "${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/lib" "${APOLLO_PATH}lib/${PACKAGE_NAME}"
    fi

    bin_path="${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/bin"
    if [ -d ${bin_path} ]
    then
        for file in $(ls ${bin_path})
        do
            if [ -d ${bin_path}"/"${file} ]
            then
                continue
            else
                ln -snf "${bin_path}/${file}" "${APOLLO_PATH}bin/${file}"
            fi
        done
    fi
fi

if [ ! -e '/apollo/modules/perception/lidar_detection_filter/data/background_filter.pb.txt' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/data' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/data/background_filter.pb.txt' '/apollo/modules/perception/lidar_detection_filter/data/background_filter.pb.txt'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/data/roi_boundary_filter.pb.txt' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/data' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/data/roi_boundary_filter.pb.txt' '/apollo/modules/perception/lidar_detection_filter/data/roi_boundary_filter.pb.txt'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/data/filter_bank.pb.txt' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/data' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/data/filter_bank.pb.txt' '/apollo/modules/perception/lidar_detection_filter/data/filter_bank.pb.txt'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/data/strategy_filter.pb.txt' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/data' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/data/strategy_filter.pb.txt' '/apollo/modules/perception/lidar_detection_filter/data/strategy_filter.pb.txt'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/dag/lidar_detection_filter.dag' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/dag' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/dag/lidar_detection_filter.dag' '/apollo/modules/perception/lidar_detection_filter/dag/lidar_detection_filter.dag'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/launch/lidar_detection_filter.launch' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/launch' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/launch/lidar_detection_filter.launch' '/apollo/modules/perception/lidar_detection_filter/launch/lidar_detection_filter.launch'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/strategy_filter/plugins.xml' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/strategy_filter' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/object_filter_bank/strategy_filter/plugins.xml' '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/strategy_filter/plugins.xml'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/roi_boundary_filter/plugins.xml' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/roi_boundary_filter' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/object_filter_bank/roi_boundary_filter/plugins.xml' '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/roi_boundary_filter/plugins.xml'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/background_filter/plugins.xml' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/background_filter' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/object_filter_bank/background_filter/plugins.xml' '/apollo/modules/perception/lidar_detection_filter/object_filter_bank/background_filter/plugins.xml'; fi
if [ ! -e '/apollo/modules/perception/lidar_detection_filter/conf/lidar_detection_filter_config.pb.txt' ]; then mkdir -p '/apollo/modules/perception/lidar_detection_filter/conf' && ln -snf '/opt/apollo/neo/share/modules/perception/lidar_detection_filter/conf/lidar_detection_filter_config.pb.txt' '/apollo/modules/perception/lidar_detection_filter/conf/lidar_detection_filter_config.pb.txt'; fi

echo "[INFO] symbolic links of ${PACKAGE_NAME} created."

if [ -f "${APOLLO_PATH}update_dylib.sh" ]
then
    sh ${APOLLO_PATH}update_dylib.sh
fi