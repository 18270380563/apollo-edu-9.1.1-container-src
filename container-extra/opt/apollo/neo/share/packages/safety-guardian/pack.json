        "if [ ! -e '/apollo/modules/safety_manager/guardian/dag/guardian.dag' ]; then mkdir -p '/apollo/modules/safety_manager/guardian/dag' && ln -snf '/opt/apollo/neo/share/modules/safety_manager/guardian/dag/guardian.dag' '/apollo/modules/safety_manager/guardian/dag/guardian.dag'; fi",
