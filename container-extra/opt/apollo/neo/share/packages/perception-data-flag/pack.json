        "if [ ! -e '/apollo/modules/perception/data/flag/perception_common.flag' ]; then mkdir -p '/apollo/modules/perception/data/flag' && ln -snf '/opt/apollo/neo/share/modules/perception/data/flag/perception_common.flag' '/apollo/modules/perception/data/flag/perception_common.flag'; fi",
