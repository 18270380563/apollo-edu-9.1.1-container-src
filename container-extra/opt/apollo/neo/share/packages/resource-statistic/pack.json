        "if [ ! -e '/apollo/modules/statistics/resource/dag/resource_statistic.dag' ]; then mkdir -p '/apollo/modules/statistics/resource/dag' && ln -snf '/opt/apollo/neo/share/modules/statistics/resource/dag/resource_statistic.dag' '/apollo/modules/statistics/resource/dag/resource_statistic.dag'; fi",
        "if [ ! -e '/apollo/modules/statistics/resource/conf/resource_statistic_conf.pb.txt' ]; then mkdir -p '/apollo/modules/statistics/resource/conf' && ln -snf '/opt/apollo/neo/share/modules/statistics/resource/conf/resource_statistic_conf.pb.txt' '/apollo/modules/statistics/resource/conf/resource_statistic_conf.pb.txt'; fi",
