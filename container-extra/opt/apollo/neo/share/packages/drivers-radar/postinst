# !/bin/sh
APOLLO_PATH='/opt/apollo/neo/'
PACKAGE_NAME='drivers-radar'
PACKAGE_NAME_WITH_VER='drivers-radar/9.1.1'
INCLUDE_PATH=''
echo "[INFO] start to create symbolic links of ${PACKAGE_NAME}"
echo '[WARN] the links of pre-version will be overwrited!'

mkdir -p ${APOLLO_PATH}bin
mkdir -p ${APOLLO_PATH}include
mkdir -p ${APOLLO_PATH}lib

chmod a+rw ${APOLLO_PATH}bin ${APOLLO_PATH}include ${APOLLO_PATH}lib ${APOLLO_PATH}packages

if [ ! -d ${APOLLO_PATH}/share/packages/${PACKAGE_NAME} ]
then
    ln -snf ${APOLLO_PATH}packages/${PACKAGE_NAME_WITH_VER} ${APOLLO_PATH}packages/${PACKAGE_NAME}/latest

    if [ "${INCLUDE_PATH}" = "" ]
    then
        ori_inc_path="${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/include"
        if [ -d ${ori_inc_path} ]
        then
            for file in $(ls ${ori_inc_path})
            do
                if [ -d ${ori_inc_path}"/"${file} ]
                then
                    ln -snf ${ori_inc_path}"/"${file} "${APOLLO_PATH}include/${file}"
                fi
            done
        fi
    else
        if [ $(dirname ${INCLUDE_PATH}) != '.' ]
        then
            mkdir -p "${APOLLO_PATH}include/$(dirname ${INCLUDE_PATH})"
            chmod a+rw "${APOLLO_PATH}include/$(dirname ${INCLUDE_PATH})"
        fi
        ln -snf "${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/include" "${APOLLO_PATH}include/${INCLUDE_PATH}"
    fi

    if [ -d ${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/lib ]
    then
        ln -snf "${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/lib" "${APOLLO_PATH}lib/${PACKAGE_NAME}"
    fi

    bin_path="${APOLLO_PATH}packages/${PACKAGE_NAME}/latest/bin"
    if [ -d ${bin_path} ]
    then
        for file in $(ls ${bin_path})
        do
            if [ -d ${bin_path}"/"${file} ]
            then
                continue
            else
                ln -snf "${bin_path}/${file}" "${APOLLO_PATH}bin/${file}"
            fi
        done
    fi
fi

if [ ! -e '/apollo/modules/drivers/radar/conti_radar/dag/conti_radar.dag' ]; then mkdir -p '/apollo/modules/drivers/radar/conti_radar/dag' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/conti_radar/dag/conti_radar.dag' '/apollo/modules/drivers/radar/conti_radar/dag/conti_radar.dag'; fi
if [ ! -e '/apollo/modules/drivers/radar/conti_radar/launch/conti_radar.launch' ]; then mkdir -p '/apollo/modules/drivers/radar/conti_radar/launch' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/conti_radar/launch/conti_radar.launch' '/apollo/modules/drivers/radar/conti_radar/launch/conti_radar.launch'; fi
if [ ! -e '/apollo/modules/drivers/radar/conti_radar/conf/radar_front_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/conti_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/conti_radar/conf/radar_front_conf.pb.txt' '/apollo/modules/drivers/radar/conti_radar/conf/radar_front_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/conti_radar/conf/conti_radar_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/conti_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/conti_radar/conf/conti_radar_conf.pb.txt' '/apollo/modules/drivers/radar/conti_radar/conf/conti_radar_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/conti_radar/conf/radar_rear_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/conti_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/conti_radar/conf/radar_rear_conf.pb.txt' '/apollo/modules/drivers/radar/conti_radar/conf/radar_rear_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/oculii_radar/dag/oculii_radar.dag' ]; then mkdir -p '/apollo/modules/drivers/radar/oculii_radar/dag' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/oculii_radar/dag/oculii_radar.dag' '/apollo/modules/drivers/radar/oculii_radar/dag/oculii_radar.dag'; fi
if [ ! -e '/apollo/modules/drivers/radar/oculii_radar/launch/oculii_radar.launch' ]; then mkdir -p '/apollo/modules/drivers/radar/oculii_radar/launch' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/oculii_radar/launch/oculii_radar.launch' '/apollo/modules/drivers/radar/oculii_radar/launch/oculii_radar.launch'; fi
if [ ! -e '/apollo/modules/drivers/radar/oculii_radar/conf/oculii_radar_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/oculii_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/oculii_radar/conf/oculii_radar_conf.pb.txt' '/apollo/modules/drivers/radar/oculii_radar/conf/oculii_radar_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/ultrasonic_radar/dag/ultrasonic_radar.dag' ]; then mkdir -p '/apollo/modules/drivers/radar/ultrasonic_radar/dag' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/ultrasonic_radar/dag/ultrasonic_radar.dag' '/apollo/modules/drivers/radar/ultrasonic_radar/dag/ultrasonic_radar.dag'; fi
if [ ! -e '/apollo/modules/drivers/radar/ultrasonic_radar/launch/ultrasonic_radar.launch' ]; then mkdir -p '/apollo/modules/drivers/radar/ultrasonic_radar/launch' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/ultrasonic_radar/launch/ultrasonic_radar.launch' '/apollo/modules/drivers/radar/ultrasonic_radar/launch/ultrasonic_radar.launch'; fi
if [ ! -e '/apollo/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar.conf' ]; then mkdir -p '/apollo/modules/drivers/radar/ultrasonic_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar.conf' '/apollo/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar.conf'; fi
if [ ! -e '/apollo/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/ultrasonic_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar_conf.pb.txt' '/apollo/modules/drivers/radar/ultrasonic_radar/conf/ultrasonic_radar_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/nano_radar/dag/nano_radar.dag' ]; then mkdir -p '/apollo/modules/drivers/radar/nano_radar/dag' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/nano_radar/dag/nano_radar.dag' '/apollo/modules/drivers/radar/nano_radar/dag/nano_radar.dag'; fi
if [ ! -e '/apollo/modules/drivers/radar/nano_radar/launch/nano_radar.launch' ]; then mkdir -p '/apollo/modules/drivers/radar/nano_radar/launch' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/nano_radar/launch/nano_radar.launch' '/apollo/modules/drivers/radar/nano_radar/launch/nano_radar.launch'; fi
if [ ! -e '/apollo/modules/drivers/radar/nano_radar/conf/nano_radar_front_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/nano_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/nano_radar/conf/nano_radar_front_conf.pb.txt' '/apollo/modules/drivers/radar/nano_radar/conf/nano_radar_front_conf.pb.txt'; fi
if [ ! -e '/apollo/modules/drivers/radar/racobit_radar/dag/racobit_radar.dag' ]; then mkdir -p '/apollo/modules/drivers/radar/racobit_radar/dag' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/racobit_radar/dag/racobit_radar.dag' '/apollo/modules/drivers/radar/racobit_radar/dag/racobit_radar.dag'; fi
if [ ! -e '/apollo/modules/drivers/radar/racobit_radar/launch/racobit_radar.launch' ]; then mkdir -p '/apollo/modules/drivers/radar/racobit_radar/launch' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/racobit_radar/launch/racobit_radar.launch' '/apollo/modules/drivers/radar/racobit_radar/launch/racobit_radar.launch'; fi
if [ ! -e '/apollo/modules/drivers/radar/racobit_radar/conf/racobit_radar.conf' ]; then mkdir -p '/apollo/modules/drivers/radar/racobit_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/racobit_radar/conf/racobit_radar.conf' '/apollo/modules/drivers/radar/racobit_radar/conf/racobit_radar.conf'; fi
if [ ! -e '/apollo/modules/drivers/radar/racobit_radar/conf/racobit_radar_conf.pb.txt' ]; then mkdir -p '/apollo/modules/drivers/radar/racobit_radar/conf' && ln -snf '/opt/apollo/neo/share/modules/drivers/radar/racobit_radar/conf/racobit_radar_conf.pb.txt' '/apollo/modules/drivers/radar/racobit_radar/conf/racobit_radar_conf.pb.txt'; fi

echo "[INFO] symbolic links of ${PACKAGE_NAME} created."

if [ -f "${APOLLO_PATH}update_dylib.sh" ]
then
    sh ${APOLLO_PATH}update_dylib.sh
fi