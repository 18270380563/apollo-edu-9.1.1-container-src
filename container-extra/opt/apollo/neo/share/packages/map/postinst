if [ ! -e '/apollo/modules/map/testdata/navigation_dummy/navigation_info.pb.txt' ]; then mkdir -p '/apollo/modules/map/testdata/navigation_dummy' && ln -snf '/opt/apollo/neo/share/modules/map/testdata/navigation_dummy/navigation_info.pb.txt' '/apollo/modules/map/testdata/navigation_dummy/navigation_info.pb.txt'; fi
