if [ ! -e '/apollo/modules/map/relative_map/conf/relative_map.conf' ]; then mkdir -p '/apollo/modules/map/relative_map/conf' && ln -snf '/opt/apollo/neo/share/modules/map/relative_map/conf/relative_map.conf' '/apollo/modules/map/relative_map/conf/relative_map.conf'; fi
if [ ! -e '/apollo/modules/map/relative_map/conf/navigator_config.pb.txt' ]; then mkdir -p '/apollo/modules/map/relative_map/conf' && ln -snf '/opt/apollo/neo/share/modules/map/relative_map/conf/navigator_config.pb.txt' '/apollo/modules/map/relative_map/conf/navigator_config.pb.txt'; fi
if [ ! -e '/apollo/modules/map/relative_map/conf/relative_map_config.pb.txt' ]; then mkdir -p '/apollo/modules/map/relative_map/conf' && ln -snf '/opt/apollo/neo/share/modules/map/relative_map/conf/relative_map_config.pb.txt' '/apollo/modules/map/relative_map/conf/relative_map_config.pb.txt'; fi

echo "[INFO] symbolic links of ${PACKAGE_NAME} created."

if [ -f "${APOLLO_PATH}update_dylib.sh" ]
then
    sh ${APOLLO_PATH}update_dylib.sh
fi