    "preinst_extend_ops": [],
    "postinst_extend_ops": [
        "if [ ! -e '/apollo/modules/statistics/latency/dag/latency_statistic.dag' ]; then mkdir -p '/apollo/modules/statistics/latency/dag' && ln -snf '/opt/apollo/neo/share/modules/statistics/latency/dag/latency_statistic.dag' '/apollo/modules/statistics/latency/dag/latency_statistic.dag'; fi",
