    module_library : "modules/safety_manager/checker/collision_checker/libsafety_collision_checker_component.so"
    timer_components {
        class_name : "CollisionCheckerComponent"
        config {
            name: "safety_collision_checker"
            interval: 1000  # in milliseconds
